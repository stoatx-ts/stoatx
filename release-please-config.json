{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    "packages/stoatx": {
      "release-type": "node",
      "package-name": "stoatx"
    },
    "packages/client": {
      "release-type": "node",
      "package-name": "@stoatx/client",
      "extra-files": [
        {
          "type": "json",
          "path": "packages/stoatx/package.json",
          "jsonpath": "$.peerDependencies['@stoatx/client']"
        }
      ]
    }
  },
  "plugins": ["node-workspace"]
}
