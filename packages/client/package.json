{
  "name": "@stoatx/client",
  "version": "0.10.1",
  "type": "module",
  "description": "A typed client library for the Stoat API.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stoatx-ts/stoatx.git"
  },
  "bugs": {
    "url": "https://github.com/stoatx-ts/stoatx/issues"
  },
  "homepage": "https://github.com/stoatx-ts/stoatx#readme",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "browser": "./dist/browser.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": "./dist/browser.js",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsup --config tsup.browser.config.ts",
    "dev": "tsup --watch",
    "lint": "eslint src/**/*.ts"
  },
  "dependencies": {
    "@livekit/rtc-node": "^0.13.29",
    "events": "^3.3.0",
    "stoat-api": "^0.16.0",
    "ulid": "^3.0.2"
  }
}
