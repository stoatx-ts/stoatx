{
  "name": "@stoatx/voice",
  "version": "0.0.0",
  "type": "module",
  "description": "Shared voice connection and manager for @stoatx/voice-node and @stoatx/voice-browser.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stoatx-ts/stoatx.git"
  },
  "bugs": {
    "url": "https://github.com/stoatx-ts/stoatx/issues"
  },
  "homepage": "https://github.com/stoatx-ts/stoatx#readme",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/**/*.ts"
  },
  "dependencies": {
    "events": "^3.3.0"
  },
  "peerDependencies": {
    "@stoatx/client": "^0.10.1"
  },
  "devDependencies": {
    "@stoatx/client": "workspace:*",
    "ulid": "^3.0.2"
  }
}
